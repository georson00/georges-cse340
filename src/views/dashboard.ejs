<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2>Dashboard</h2>
    <p>Name: <%= name %></p>
    <p>Username: <%= email %></p>
    
    <% if (user && user.role_name === 'admin') { %>
    <a href="/users"> View Users</a>
    <% } %>
    <section aria-labelledby="volunteered-projects-heading">
  <h2 id="volunteered-projects-heading">My Volunteer Projects</h2>

  <% if (volunteeredProjects.length === 0) { %>
    <p>You have not signed up to volunteer for any projects yet.</p>
    <a href="/projects">Browse service projects</a>
  <% } else { %>
    <ul>
      <% volunteeredProjects.forEach(project => { %>
        <li>
          <h3>
            <a href="/project/<%= project.project_id %>">
              <%= project.title %>
            </a>
          </h3>

          <p><%= project.location %></p>
          <p>
        <strong>Date:</strong>
        <%= new Date(project.project_date).toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
          timeZone: 'UTC'
        }) %> 
    </p>

          <form
            action="/project/<%= project.project_id %>/volunteer/remove"
            method="post"
          >
            <input type="hidden" name="returnTo" value="dashboard">

            <button type="submit" class="button-link">
              Remove my signup for <%= project.title %>
            </button>
          </form>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>
</main>

<%- include('partials/footer') %>