<%- include('partials/header') %>

<main>
  <h1><%= title %></h1>
  <h2>Upcoming Service Projects</h2>
  <ul>
    <% projects.forEach(project => { %>
    <li>
      
      <strong>
        Date: 
        <%= new Date(project.project_date).toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
          timezone: 'UTC'
        }) %> <%= project.title %>
       <a href="/organization/<%= project.organization_id %>">
            <%= project.organization_name %>
        </a>
    </strong> 
    <a href="/project/<%= project.project_id %>"><%= project.title %></a>
    </li>
    <% }); %>

  </ul>
  <p><a href="/new-project">Add a New Service Project</a></p>

</main>

<%- include('partials/footer') %>
