<%- include('partials/header') %>

<main>
  <h1><%= category.name %></h1>
  <div>
    <% if (user && user.role_name === 'admin') { %>
      <a
    href="/edit-category/<%= category.category_id %>"
    class="button-link">
    Edit Category
  </a>
    <% } %>
    </div>

  <section aria-labelledby="projects-heading">
    <h2 id="projects-heading">Service Projects</h2>

    <% if (projects.length === 0) { %>
      <p>There are currently no service projects in this category.</p>
    <% } else { %>
      <ul class="project-list">
        <% projects.forEach(project => { %>
          <li class="project-tile">
            <a href="/project/<%= project.project_id %>">
              <%= project.title %>
            </a>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>
</main>

<%- include('partials/footer') %>